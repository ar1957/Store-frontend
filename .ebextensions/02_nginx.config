# Proxy and buffer settings are managed via .platform/nginx/conf.d/
# Scanner blocking lives in .platform/nginx/conf.d/elasticbeanstalk/scanner_block.conf

files:
  "/etc/nginx/conf.d/proxy_buffers.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      proxy_buffer_size 32k;
      proxy_buffers 16 128k;
      proxy_busy_buffers_size 256k;
      client_max_body_size 50m;
